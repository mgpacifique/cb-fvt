# ==============================================================================
# CB-FVT Production Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=production

# Public Spatial Frontend (Port 3000)
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:4000

# Dedicated Admin Control Plane (Port 4000)
ADMIN_PORT=4000
ADMIN_MASTER_EMAIL=p.gatabazi@alustudent.com
ADMIN_MASTER_USERNAME=pacifique

# Data Sources API Keys (Optional overrides)
FEWSNET_API_KEY=
HDX_API_KEY=

# Persistent Volume Path
DATA_DIR=/app/data
