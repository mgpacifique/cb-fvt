# syntax=docker/dockerfile:1

# ==============================================================================
# CB-FVT Dedicated Admin Control Plane (Port 4000)
# ==============================================================================
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000

# Install dependencies needed by Node.js
RUN apk add --no-cache libc6-compat curl

# Non-root user for security
RUN addgroup --system --gid 1002 adminteam && \
    adduser --system --uid 1002 adminuser

# Copy package descriptors
COPY package.json ./

# Copy server entrypoint and libraries
COPY server/ ./server/
COPY src/lib/auth/ ./src/lib/auth/

# Create persistent data directory and grant permissions
RUN mkdir -p /app/data && chown -R adminuser:adminteam /app

USER adminuser

EXPOSE 4000

# Health check probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:4000/health || exit 1

CMD ["node", "--experimental-strip-types", "server/adminServer.ts"]
