# CB-FVT (Cross-Border Food Volatility Tracker) Environment Configuration

# FEWS NET Data Warehouse (FDW) REST API
# Swagger UI Documentation: https://fdw.fews.net/api/schema/swagger-ui/
FEWSNET_API_BASE_URL=https://fdw.fews.net
FEWSNET_USERNAME=
FEWSNET_PASSWORD=
FEWSNET_API_TOKEN=

# Automated Weekly Ingestion Cron Secret (Optional header authorization)
CRON_SECRET=cbfvt_weekly_sync_secret_2026

# Regional Currency Baselines (Optional overrides for central bank pegs)
UGX_USD_PEG=3700
RWF_USD_PEG=1350
KES_USD_PEG=129
TZS_USD_PEG=2600
CDF_USD_PEG=2850
